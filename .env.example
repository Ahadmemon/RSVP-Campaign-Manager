# GlobalVox RSVP Campaign Manager Environment Variables

# Backend Port (Default: 5001)
PORT=5001

# MongoDB Connection URI
# 1. For Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/globalvox-rsvp
#
# 2. For MongoDB Atlas Cloud (Free):
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxx.mongodb.net/globalvox-rsvp?retryWrites=true&w=majority
#
# Note: If MONGODB_URI is left blank or commented out, the app uses the built-in In-Memory Demo Engine!
